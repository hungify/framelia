{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "*.tsbuildinfo",
    "apps/ui/auto-imports.d.ts",
    "apps/ui/components.d.ts",
    "apps/ui/typed-router.d.ts"
  ]
}
