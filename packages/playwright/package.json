{
  "name": "@framelia/playwright",
  "version": "0.0.5",
  "description": "Playwright custom matchers for Figma-to-web and web-to-web visual verification.",
  "homepage": "https://github.com/hungify/framelia/tree/main/packages/playwright",
  "bugs": {
    "url": "https://github.com/hungify/framelia/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hungify/framelia.git",
    "directory": "packages/playwright"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "framelia-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "framelia-dev": "./src/register.ts",
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./reporter": {
      "framelia-dev": "./src/reporter.ts",
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./create-matchers": {
      "framelia-dev": "./src/create-matchers.ts",
      "types": "./dist/create-matchers.d.ts",
      "default": "./dist/create-matchers.js"
    },
    "./project-policy": {
      "framelia-dev": "./src/project-policy.ts",
      "types": "./dist/project-policy.d.ts",
      "default": "./dist/project-policy.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "pnpm --filter @framelia/playwright... build && playwright test --config=playwright.config.ts",
    "test:smoke:define-figma-tests": "pnpm --filter @framelia/playwright... build && playwright test --config=playwright.define-figma-tests.config.ts",
    "test:smoke:run-bundle": "pnpm --filter @framelia/playwright... build && playwright test --config=playwright.run-bundle.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@framelia/contracts": "workspace:*",
    "@framelia/verify": "workspace:*",
    "nanoid": "3.3.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@framelia/dashboard-server": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@types/node": "26.0.1",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@framelia/dashboard-server": "workspace:*",
    "@playwright/test": "^1.61.1"
  },
  "peerDependenciesMeta": {
    "@framelia/dashboard-server": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.18.0"
}
