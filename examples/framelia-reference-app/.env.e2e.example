PORT=8888
E2E_USER_EMAIL=demo@framelia.local
E2E_USER_PASSWORD=framelia-demo-password

# Optional: only needed to run the Figma matcher (pnpm test:figma). playwright.config.ts
# loads this file, so setting it here is enough for that command -- leave blank to skip
# it (everything else in the suite runs without it). Raw CLI commands that hit the Figma
# API outside Playwright (pnpm cli:contract:login, pnpm cli:capture) do NOT read this
# file -- framelia's own env lookup is .env.local/.env, so pass it inline there instead:
#   FIGMA_ACCESS_TOKEN=... pnpm cli:contract:login
FIGMA_ACCESS_TOKEN=
