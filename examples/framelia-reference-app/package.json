{
  "name": "framelia-reference-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--import=tsx/esm playwright test",
    "test:unauth": "NODE_OPTIONS=--import=tsx/esm playwright test --project=unauthenticated",
    "test:auth": "NODE_OPTIONS=--import=tsx/esm playwright test --project=authenticated",
    "test:web": "NODE_OPTIONS=--import=tsx/esm playwright test e2e/specs/web-to-web-*.spec.ts --project=unauthenticated",
    "test:figma": "NODE_OPTIONS=--import=tsx/esm playwright test e2e/specs/figma.spec.ts --project=unauthenticated",
    "test:e2e": "NODE_OPTIONS=--import=tsx/esm playwright test e2e",
    "test:e2e:real-flow": "NODE_OPTIONS=--import=tsx/esm playwright test e2e --grep @real-flow",
    "framelia": "framelia",
    "cli:init": "framelia init --project-root .framelia/init-preview --force",
    "cli:status": "framelia status",
    "cli:schema": "framelia schema --target artifact",
    "cli:contract:login": "framelia contract create",
    "cli:dashboard": "framelia dashboard --no-open",
    "done-gate": "framelia done-gate",
    "lint": "vp lint --type-aware --type-check",
    "lint:fix": "vp lint --type-aware --type-check --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "prepare": "vp config",
    "deps": "vpx taze@latest -Ilw --maturity-period 3",
    "tanstack": "vpx @tanstack/cli@latest",
    "ui": "vpx shadcn@latest",
    "skills": "vpx skills@latest",
    "intent": "vpx @tanstack/intent@latest"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/inter": "5.3.0",
    "@icons-pack/react-simple-icons": "13.13.0",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-start": "1.168.46",
    "class-variance-authority": "0.7.1",
    "cnfast": "0.1.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.18.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@framelia/dashboard-server": "0.0.2",
    "@framelia/playwright": "0.0.2",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-a11y": "0.2.0",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.10",
    "@tanstack/react-router-devtools": "1.167.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "framelia": "0.0.2",
    "nitro": "3.0.260610-beta",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.22.4",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "generator": "create-mugnavo",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
