{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "plugins": ["typescript", "unicorn", "import", "promise", "node", "vitest", "oxc"],
  "env": {
    "node": true
  },
  "ignorePatterns": ["dist", "node_modules", "*.tsbuildinfo"],
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "packages/cli/tests/**",
        "packages/verify/tests/**",
        "apps/ui/tests/**"
      ],
      "plugins": ["vitest"]
    },
    {
      "files": ["apps/ui/main.ts"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": [
        "packages/verify/src/capture/core.ts",
        "packages/verify/src/navigation.ts",
        "packages/cli/src/commands/doctor.ts",
        "packages/cli/src/ui/report.ts",
        "packages/cli/src/contract.ts"
      ],
      "rules": {
        "eslint/no-await-in-loop": "off"
      }
    }
  ]
}
