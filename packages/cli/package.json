{
  "name": "framelia",
  "version": "0.0.3",
  "description": "CLI-first Figma-to-web and web-to-web visual verification with stable capture and artifact-based done gates.",
  "keywords": [
    "cli",
    "figma",
    "playwright",
    "screenshot",
    "visual-regression",
    "visual-testing"
  ],
  "homepage": "https://github.com/hungify/framelia/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/hungify/framelia/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hungify/framelia.git",
    "directory": "packages/cli"
  },
  "bin": {
    "framelia": "bin/framelia.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "framelia-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "cli": "tsx src/cli.ts",
    "pretest": "pnpm --filter @framelia/contracts build && pnpm --filter @framelia/verify build && pnpm --filter @framelia/dashboard-server build && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm test",
    "done-gate": "tsx src/cli.ts done-gate"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@framelia/contracts": "workspace:*",
    "@framelia/dashboard-server": "workspace:*",
    "@framelia/verify": "workspace:*",
    "commander": "^15.0.0",
    "nanoid": "3.3.16",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.61.1",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.18.0"
}
