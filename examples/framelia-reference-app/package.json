{
  "name": "framelia-reference-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--import=tsx/esm playwright test",
    "test:unauth": "NODE_OPTIONS=--import=tsx/esm playwright test --project=unauthenticated",
    "test:auth": "NODE_OPTIONS=--import=tsx/esm playwright test --project=authenticated",
    "test:web": "NODE_OPTIONS=--import=tsx/esm playwright test e2e/specs/web-to-web-*.spec.ts --project=unauthenticated",
    "test:figma": "NODE_OPTIONS=--import=tsx/esm playwright test e2e/specs/figma.spec.ts --project=unauthenticated",
    "test:e2e": "NODE_OPTIONS=--import=tsx/esm playwright test e2e",
    "test:e2e:real-flow": "NODE_OPTIONS=--import=tsx/esm playwright test e2e --grep @real-flow",
    "test:cli": "NODE_OPTIONS=--import=tsx/esm playwright test e2e/specs/cli.spec.ts --project=unauthenticated",
    "framelia:build": "pnpm --dir ../.. --filter @framelia/contracts --filter @framelia/verify --filter @framelia/dashboard-server --filter framelia run build",
    "framelia": "framelia",
    "cli:init": "framelia init",
    "cli:status": "framelia status",
    "cli:schema": "framelia schema --target artifact",
    "cli:auth": "framelia auth --url http://localhost:8888/login --yes",
    "cli:contract:login": "framelia contract create --target-url http://localhost:8888/login --contract-id login.desktop --viewport desktop --scope page --page-reason \"Baseline node represents complete page.\" --force",
    "cli:contract:suggest-masks": "framelia contract suggest-masks --target-url http://localhost:8888/login",
    "cli:dashboard": "framelia dashboard --no-open",
    "cli:open": "framelia open --artifact .framelia/visual-verifications/login/visual-verification.json --no-open",
    "cli:capture": "framelia capture --file-key 6OWioRfOFWhE2ymylsPSH4 --node-id 1037:71575 --out .framelia/figma-gold.png",
    "cli:compare": "framelia compare --baseline .framelia/figma-gold.png --actual .framelia/visual-verifications/login/actual.png --out-dir .framelia/comparisons/latest",
    "done-gate": "framelia done-gate",
    "lint": "vp lint --type-aware --type-check",
    "lint:fix": "vp lint --type-aware --type-check --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "prepare": "vp config",
    "db": "drizzle-kit",
    "db:setup": "docker compose up -d && vpr db push",
    "deps": "vpx taze@latest -Ilw --maturity-period 3",
    "tanstack": "vpx @tanstack/cli@latest",
    "ui": "vpx shadcn@latest",
    "auth": "vpx auth@latest",
    "auth:secret": "vpx auth@latest secret",
    "auth:generate": "vpx auth@latest generate --config ./src/lib/auth/auth.ts --y --output ./src/lib/db/schema/auth.schema.ts",
    "skills": "vpx skills@latest",
    "intent": "vpx @tanstack/intent@latest"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@fontsource-variable/inter": "5.3.0",
    "@icons-pack/react-simple-icons": "13.13.0",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.46",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "cnfast": "0.1.0",
    "drizzle-orm": "1.0.0-rc.4",
    "lucide-react": "1.31.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.18.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@framelia/dashboard-server": "link:../../packages/dashboard-server",
    "@framelia/playwright": "link:../../packages/playwright",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-a11y": "0.2.0",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.10",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router-devtools": "1.167.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "framelia": "link:../../packages/cli",
    "nitro": "3.0.260610-beta",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.22.4",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "generator": "create-mugnavo",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
