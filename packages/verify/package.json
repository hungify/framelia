{
  "name": "@framelia/verify",
  "version": "0.0.3",
  "description": "Visual verification engine for Figma-to-web and web-to-web workflows.",
  "homepage": "https://github.com/hungify/framelia/tree/main/packages/verify",
  "bugs": {
    "url": "https://github.com/hungify/framelia/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hungify/framelia.git",
    "directory": "packages/verify"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "framelia-dev": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "framelia-dev": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:domain-boundary": "node scripts/check-domain-boundary.mjs",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm test && pnpm run check:domain-boundary"
  },
  "dependencies": {
    "@figma/rest-api-spec": "^0.41.0",
    "@framelia/contracts": "workspace:*",
    "@playwright/test": "^1.61.1",
    "nanoid": "3.3.16",
    "p-map": "^7.0.6",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "ssim.js": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.18.0"
}
