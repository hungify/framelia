PORT=8888
E2E_USER_EMAIL=demo@framelia.local
E2E_USER_PASSWORD=framelia-demo-password

# Needed only to pin or refresh a Figma baseline once, locally (`framelia contract
# refresh-baseline`/`contract create`/`contract migrate`) -- never at test-run time.
# `pnpm test:visual` compares against the already-pinned offline snapshot and never
# reads this value.
FIGMA_ACCESS_TOKEN=
