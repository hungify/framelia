{
  "name": "framelia-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Visual verification monorepo for Figma-to-web and web-to-web workflows.",
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter @framelia/contracts build && pnpm --filter @framelia/verify build && pnpm --filter @framelia/dashboard-server build && pnpm --filter @framelia/playwright build && pnpm --filter framelia build",
    "dev:dashboard": "pnpm --filter @framelia/dashboard dev",
    "framelia": "pnpm --filter framelia cli",
    "typecheck": "pnpm --filter '!./examples/**' -r typecheck",
    "test": "pnpm --filter @framelia/contracts test && pnpm --filter @framelia/verify test && pnpm --filter @framelia/dashboard-server test && pnpm --filter @framelia/playwright test && pnpm --filter framelia test && pnpm --filter @framelia/dashboard test && pnpm --filter @framelia/example test",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "test:mutation:smoke": "pnpm --filter @framelia/contracts exec stryker run ../../stryker.smoke.config.mjs",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "lint:boundaries": "depcruise packages apps scripts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "size": "pnpm --filter @framelia/dashboard build && size-limit",
    "prepare": "simple-git-hooks && node scripts/link-agents.mjs",
    "agents:link": "node scripts/link-agents.mjs",
    "validate": "pnpm --filter @framelia/contracts check:zero-deps && pnpm run typecheck && pnpm run lint:boundaries && pnpm run test && pnpm run lint && pnpm run fmt:check && pnpm run knip",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@size-limit/file": "^14.2.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.89.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "jiti": "^2.7.0",
    "knip": "^6.42.1",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^14.2.0",
    "typescript": "6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit \"$1\"",
    "pre-push": "pnpm typecheck"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.18.0"
}
